  <DataSources>
    <DataSource Name="SharedDataSource">
      <DataSourceReference>SharedDataSource</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>03f400ff-c83d-4dea-829e-f98383038c66</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>SharedDataSource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@TicketClass">
            <Value>=Parameters!TicketClass.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT 
    fj.FactID,
    dp.FullDate AS PurchaseDate,
    dj.FullDate AS JourneyDate,
    ds.StationName AS DepartureStation,
    ar.StationName AS ArrivalStation,
    tk.TicketClass,
    fj.Price,
    fj.JourneyStatus
FROM DW_Fact_Journey1_ fj
JOIN DW_Dim_Date1_ dp ON fj.PurchaseDateKey = dp.DateKey
JOIN DW_Dim_Date1_ dj ON fj.JourneyDateKey = dj.DateKey
JOIN DW_Dim_Station1_ ds ON fj.DepartureStationKey = ds.StationKey
JOIN DW_Dim_Station1_ ar ON fj.ArrivalStationKey = ar.StationKey
JOIN DW_Dim_Ticket1_ tk ON fj.TicketKey = tk.TicketKey
WHERE tk.TicketClass = @TicketClass</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="FactID">
          <DataField>FactID</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="PurchaseDate">
          <DataField>PurchaseDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="JourneyDate">
          <DataField>JourneyDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="DepartureStation">
          <DataField>DepartureStation</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ArrivalStation">
          <DataField>ArrivalStation</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="TicketClass">
          <DataField>TicketClass</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Price">
          <DataField>Price</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="JourneyStatus">
          <DataField>JourneyStatus</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
      <Filters>
        <Filter>
          <FilterExpression>=Fields!TicketClass.Value</FilterExpression>
          <Operator>Equal</Operator>
          <FilterValues>
            <FilterValue>=Parameters!TicketClass.Value</FilterValue>
          </FilterValues>
        </Filter>
      </Filters>
    </DataSet>
  </DataSets>
