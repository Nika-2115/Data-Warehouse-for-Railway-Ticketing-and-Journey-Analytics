  <DataSources>
    <DataSource Name="SharedDataSource">
      <DataSourceReference>SharedDataSource</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>eff7a3f1-3434-44f8-a87e-d300f27d46c9</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>SharedDataSource</DataSourceName>
        <CommandText>SELECT TOP 50
    f.FactID,
    pd.FullDate AS PurchaseDate,
    jd.FullDate AS JourneyDate,
    ds.StationName AS DepartureStation,
    asn.StationName AS ArrivalStation,
    tk.TicketType,
    tk.TicketClass,
    pm.PaymentMethod,
    f.Price,
    f.JourneyStatus
FROM DW_Fact_Journey1_ f
JOIN DW_Dim_Date1_ pd ON f.PurchaseDateKey = pd.DateKey
JOIN DW_Dim_Date1_ jd ON f.JourneyDateKey = jd.DateKey
JOIN DW_Dim_Station1_ ds ON f.DepartureStationKey = ds.StationKey
JOIN DW_Dim_Station1_ asn ON f.ArrivalStationKey = asn.StationKey
JOIN DW_Dim_Ticket1_ tk ON f.TicketKey = tk.TicketKey
JOIN DW_Dim_Payment1_ pm ON f.PaymentKey = pm.PaymentKey
ORDER BY f.Price DESC;</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="FactID">
          <DataField>FactID</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="PurchaseDate">
          <DataField>PurchaseDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="JourneyDate">
          <DataField>JourneyDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="DepartureStation">
          <DataField>DepartureStation</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ArrivalStation">
          <DataField>ArrivalStation</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="TicketType">
          <DataField>TicketType</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="TicketClass">
          <DataField>TicketClass</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="PaymentMethod">
          <DataField>PaymentMethod</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Price">
          <DataField>Price</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="JourneyStatus">
          <DataField>JourneyStatus</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
