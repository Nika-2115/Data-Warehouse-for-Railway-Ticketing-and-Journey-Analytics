  <DataSources>
    <DataSource Name="SharedDataSource">
      <DataSourceReference>SharedDataSource</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>7a39f44e-fa4d-4421-8191-f11b5e801e8d</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>SharedDataSource</DataSourceName>
        <CommandText>SELECT 
    ds.Zone,
    ds.StationName,
    SUM(fj.Price) AS TotalRevenue
FROM DW_Fact_Journey1_ fj
JOIN DW_Dim_Station1_ ds ON fj.DepartureStationKey = ds.StationKey
GROUP BY ds.Zone, ds.StationName
ORDER BY ds.Zone, ds.StationName;</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Zone">
          <DataField>Zone</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="StationName">
          <DataField>StationName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="TotalRevenue">
          <DataField>TotalRevenue</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
